{
  "name": "bp730i",
  "version": "0.1.0",
  "description": "Driverless printing for the Labelident BP730i (Godex RT730i) label printer: EZPL output over CUPS or TCP",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "bp730i": "src/cli.ts"
  },
  "scripts": {
    "bp730i": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun scripts/gen-command-table.ts --check && bun test",
    "docs:commands": "bun scripts/gen-command-table.ts"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
