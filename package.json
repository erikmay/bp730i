{
  "name": "bp730i",
  "version": "0.1.0",
  "private": true,
  "description": "Driverless printing for the Labelident BP730i (Godex RT730i) label printer: EZPL output over CUPS or TCP",
  "license": "MIT",
  "bin": {
    "bp730i": "src/cli.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "bp730i": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt && oxlint --fix",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun scripts/gen-command-table.ts --check && bun test",
    "docs:commands": "bun scripts/gen-command-table.ts"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/emscripten": "^1.41.6",
    "@types/pngjs": "^6.0.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}
